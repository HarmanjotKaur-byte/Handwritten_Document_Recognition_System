# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO

# Storage and Database
DATABASE_PATH=data/database/documents.db

# Device Configuration (auto, cpu, cuda)
DEVICE=cpu

# OCR Model Configuration
OCR_MODEL_PATH=models/crnn_handwriting.pth
OCR_IMAGE_HEIGHT=32
OCR_BATCH_SIZE=8

# Document Classification Configuration
CLASSIFIER_MODEL_PATH=models/document_classifier.joblib
VECTORIZER_MODEL_PATH=models/tfidf_vectorizer.joblib
CLASSIFIER_CONFIDENCE_THRESHOLD=0.50

# spaCy NLP Model
SPACY_MODEL_NAME=en_core_web_sm
